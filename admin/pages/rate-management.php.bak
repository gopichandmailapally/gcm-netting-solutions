<script>
let changedCount = 0;

function markChanged(input) {
    input.classList.add('changed');
    input.style.backgroundColor = '#FEF3C7';
    changedCount++;
    document.getElementById('changes-count').textContent = changedCount;
}

function toggleCategory(categoryId) {
    const content = document.getElementById('category_' + categoryId);
    if (content) {
        content.classList.toggle('collapsed');
    }
}

function saveAllRates() {
    const rates = [];
    
    document.querySelectorAll('.rate-row').forEach(row => {
        const category = row.getAttribute('data-category');
        const service = row.getAttribute('data-service');
        const minRate = row.querySelector('.min-rate').value;
        const maxRate = row.querySelector('.max-rate').value;
        
        rates.push({
            category: category,
            service: service,
            min_rate: parseFloat(minRate),
            max_rate: parseFloat(maxRate)
        });
    });
    
    if (rates.length === 0) {
        alert('No rates to save!');
        return;
    }
    
    fetch('../api/save-rates.php', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({rates: rates})
    })
    .then(response => response.json())
    .then(result => {
        if (result.success) {
            alert('✅ All rates saved successfully!\n\n' + result.updated_count + ' services updated.\n\nThese rates will now apply to website estimations immediately!');
            
            // Reset changed indicators
            document.querySelectorAll('.rate-input.changed').forEach(input => {
                input.classList.remove('changed');
                input.style.backgroundColor = '';
            });
            
            changedCount = 0;
            document.getElementById('changes-count').textContent = '0';
        } else {
            alert('❌ Error: ' + result.message);
        }
    })
    .catch(error => {
        alert('❌ Error saving rates');
        console.error(error);
    });
}

console.log('✅ Rate Management loaded successfully!');
</script>

