    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: #CBD5E1;
    border-radius: 30px;
    transition: 0.4s;
}

.toggle-slider:before {
    position: absolute;
    content: "";
    height: 22px;
    width: 22px;
    left: 4px;
    bottom: 4px;
    background: white;
    border-radius: 50%;
    transition: 0.4s;
}

.toggle-switch input:checked + .toggle-slider {
    background: linear-gradient(135deg, #10B981, #059669);
}

.toggle-switch input:checked + .toggle-slider:before {
    transform: translateX(30px);
}

.toggle-status {
    font-weight: 600;
    color: #64748B;
    transition: color 0.3s;
}

.toggle-status.active {
