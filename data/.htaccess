# CRITICAL SECURITY: Block ALL direct HTTP access to this directory.
# The SQLite database file (local-test.db) must NEVER be downloadable via browser.
# Without this file, anyone could download your entire admin database.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Block directory listing
Options -Indexes

# Deny direct access to database files by extension
<FilesMatch "\.(db|sqlite|sqlite3)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
